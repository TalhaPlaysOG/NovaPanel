# ==============================================================================
# Nova Panel - Root Git Ignore Configuration
# ==============================================================================

# Environment and Secrets (CRITICAL: Never commit real credentials)
.env
.env.*
.env.backup*
panel/.env
panel/.env.*
panel/.env.backup*
!.env.example
!panel/.env.example
!.env.ci
!panel/.env.ci

# Dependencies
/vendor
/node_modules
panel/vendor
panel/node_modules

# Package Manager Caches
.yarn
.yarn-cache
yarn-error.log
npm-debug.log*

# Laravel Framework Caches & Temporary Storage
# Preserves storage directory structure via internal .gitignore / .gitkeep files
panel/storage/framework/cache/data/*
!panel/storage/framework/cache/data/.gitignore
!panel/storage/framework/cache/data/.gitkeep
panel/storage/framework/sessions/*
!panel/storage/framework/sessions/.gitignore
!panel/storage/framework/sessions/.gitkeep
panel/storage/framework/views/*
!panel/storage/framework/views/.gitignore
!panel/storage/framework/views/.gitkeep
panel/storage/logs/*.log
!panel/storage/logs/.gitignore
!panel/storage/logs/.gitkeep
panel/bootstrap/cache/*.php
!panel/bootstrap/cache/.gitignore
!panel/bootstrap/cache/.gitkeep

# IDE and Editor Files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db

# Tooling and Static Analysis Caches
.phpunit.result.cache
.php-cs-fixer.cache
coverage.xml
.direnv

# Build Artifacts & Temporary Archives
*.tar.gz
*.zip
*.sql
panel/public/build
panel/public/hot
panel/public/assets/manifest.json
result

# Docker Compose local overrides
docker-compose.override.yml
docker-compose.override.yaml
!docker-compose.example.yml
!docker-compose.example.yaml
panel/docker-compose.*
!panel/docker-compose.example.yml
!panel/docker-compose.example.yaml
